{
  "schema": "dnd.seed.meta-skill-update-index.v1",
  "contract_version": "1.0.0",
  "updated": "2026-07-31",
  "channel": "public-neutral",
  "repository": "https://github.com/GrazianoGuiducci/d-nd-seed.git",
  "branch": "main",
  "availability": "repository_source_after_publication_gate",
  "capabilities": [
    {
      "id": "meta-skill-awareness-layer",
      "path": "docs/meta_skill_awareness_layer.md",
      "version": "1.1.0"
    },
    {
      "id": "governed-self-improvement",
      "path": "docs/governed_self_improvement.md",
      "version": "1.1.0"
    },
    {
      "id": "seed-freshness-protocol",
      "path": "docs/seed_freshness_protocol.md",
      "version": "1.1.0"
    }
  ],
  "freshness": {
    "mode": "event_driven_with_read_only_ttl_fallback",
    "default_ttl_hours": 24,
    "check_triggers": [
      "explicit_update_request",
      "accepted_meta_evolution_event",
      "coordination_packet",
      "ttl_expired_at_node_boot"
    ],
    "allowed_result": ["current", "update_available", "incompatible", "unknown"],
    "check_implies_install": false,
    "automatic_apply": false,
    "automatic_publication": false
  },
  "private_extension_boundary": {
    "included": false,
    "statement": "Private organization overlays use a separately authorized source and are not distributed by Seed."
  },
  "node_capture": {
    "portable_invariant": "mandatory capture, optional promotion",
    "candidate_stays_local_until_reviewed": true,
    "seed_accepts_only_neutral_candidate_manifests": true
  }
}
